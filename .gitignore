.idea/
.claude/
.codex/
.wrangler/
*.tgz

# Local environment, credentials, and private keys
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.netrc
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx

# MacOS/OS junk
.DS_Store
